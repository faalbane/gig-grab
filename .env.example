# =====================
# Voice pipeline
# =====================
DEEPGRAM_API_KEY=                   # STT (Nova-3 multi for code-switching)
GROQ_API_KEY=                       # LLM (Llama 3.1 8B — fast turn-taking)
CARTESIA_API_KEY=                   # TTS (Sonic-3 multilingual)
# ELEVENLABS_API_KEY=               # alt TTS (v3) — for A/B

# =====================
# Reasoning (slower paths)
# =====================
ANTHROPIC_API_KEY=                  # Claude Sonnet 4.6 — profile synthesis, JD parsing, Hiring Copilot

# =====================
# Telephony
# =====================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                # E.164 format, e.g. +447700900123
TWILIO_VERIFY_SERVICE_SID=          # Twilio Verify for OTP at landing
TWILIO_SIP_DOMAIN=                  # <subdomain>.sip.twilio.com

# =====================
# Firebase / GCP
# =====================
FIREBASE_PROJECT_ID=gig-grab
GOOGLE_APPLICATION_CREDENTIALS=     # path to service-account.json (server-only)

# Public Firebase config (client-side — also in apps/web/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gig-grab.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gig-grab
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gig-grab.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =====================
# Notifications
# =====================
# WhatsApp Business via Twilio
TWILIO_WHATSAPP_FROM=               # whatsapp:+447700900123
SENDGRID_API_KEY=                   # transactional email

# =====================
# Infra
# =====================
REDIS_URL=redis://localhost:6379/0
METRICS_PORT=9100
