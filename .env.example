# =====================
# Voice pipeline
# =====================
DEEPGRAM_API_KEY=                   # STT (Nova-3 multi for code-switching)
GROQ_API_KEY=                       # LLM (Llama 3.1 8B — fast turn-taking)
CARTESIA_API_KEY=                   # TTS (Sonic-3 multilingual)
# ELEVENLABS_API_KEY=               # alt TTS (v3) — for A/B

# =====================
# Reasoning (slower paths)
# =====================
ANTHROPIC_API_KEY=                  # Claude Sonnet 4.6 — profile synthesis, JD parsing, Hiring Copilot

# =====================
# Telephony
# =====================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                # E.164 format, e.g. +447700900123
TWILIO_VERIFY_SERVICE_SID=          # Twilio Verify for OTP at landing
TWILIO_SIP_DOMAIN=                  # <subdomain>.sip.twilio.com

# =====================
# Database — Postgres on Cloud SQL (prod), Docker (local dev)
# =====================
# Production: Google Cloud SQL for PostgreSQL 16 with pgvector.
# Connect via the Cloud SQL Auth Proxy or the public IP + IAM/password.
# Format:
#   DATABASE_URL=postgres://gig_app:<password>@/gig_grab?host=/cloudsql/gig-grab:europe-west2:gig-grab-db
# (or via Auth Proxy locally on :5433):
#   DATABASE_URL=postgres://gig_app:<password>@127.0.0.1:5433/gig_grab
#
# Local dev (no Cloud SQL needed): start Docker Postgres first
#   docker compose -f infra/docker-compose.dev.yml up -d
#   DATABASE_URL=postgres://gig:gig@localhost:5432/gig_grab
DATABASE_URL=

# =====================
# Firebase / GCP — Auth + Hosting + Functions + Storage (we do NOT use Firestore)
# =====================
FIREBASE_PROJECT_ID=gig-grab
GOOGLE_APPLICATION_CREDENTIALS=     # path to service-account.json (server-only)

# Public Firebase config (client-side — also in apps/web/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gig-grab.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gig-grab
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gig-grab.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Production web origin — used for SMS/email links and OAuth allowlists.
NEXT_PUBLIC_APP_URL=https://gitgrab.io

# =====================
# Notifications
# =====================
# WhatsApp Business via Twilio
TWILIO_WHATSAPP_FROM=               # whatsapp:+447700900123
SENDGRID_API_KEY=                   # transactional email

# =====================
# Infra
# =====================
REDIS_URL=redis://localhost:6379/0
METRICS_PORT=9100
