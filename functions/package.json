{
  "name": "@gig-grab/functions",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --external:firebase-functions/* --alias:@gig-grab/db=../packages/db/src/index.ts",
    "build:watch": "pnpm run build --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/__tests__/*.test.ts'",
    "verify-caller": "tsx scripts/verify-caller.ts",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "deploy": "pnpm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "pdfkit": "^0.18.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "drizzle-orm": "^0.36.4",
    "esbuild": "^0.24.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.0",
    "twilio": "^5.3.0",
    "typescript": "^5"
  }
}
