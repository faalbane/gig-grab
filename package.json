{
  "name": "gig-grab",
  "private": true,
  "version": "0.0.0",
  "description": "Voice-first AI hiring agent",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "pnpm --filter @gig-grab/web dev",
    "build": "pnpm --filter @gig-grab/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "emulators": "firebase emulators:start",
    "deploy:hosting": "pnpm --filter @gig-grab/web build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "pnpm build && firebase deploy"
  },
  "engines": {
    "node": ">=20"
  }
}
